{
  "description": "Registry of CSV columns whose cells hold JSON. Each entry names the table glob, the column, and the JSON Schema file (relative to this folder) every non-blank cell must satisfy. scripts/check_json_fields.py reads it.",
  "fields": [
    {
      "table": "data/claims/*/*.csv",
      "column": "strength_json",
      "schema": "strength_json.schema.json",
      "blank_allowed": true,
      "also_in": [
        "build/all_claims.csv"
      ]
    },
    {
      "table": "data/ship_classes.csv",
      "column": "capabilities_json",
      "schema": "capabilities_json.schema.json",
      "blank_allowed": true,
      "also_in": [
        "build/other_domains/ship_classes.csv"
      ]
    },
    {
      "table": "data/aircraft_types.csv",
      "column": "performance_json",
      "schema": "performance_json.schema.json",
      "blank_allowed": true,
      "also_in": [
        "build/other_domains/aircraft_types.csv"
      ]
    },
    {
      "table": "data/toe_templates.csv",
      "column": "authorized_strength_json",
      "schema": "authorized_strength_json.schema.json",
      "blank_allowed": false,
      "also_in": [
        "build/toe_templates.csv"
      ]
    }
  ]
}
